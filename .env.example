# Local example for running with PostgreSQL/Neon
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>/<db>?sslmode=require
SPRING_DATASOURCE_USERNAME=<user>
SPRING_DATASOURCE_PASSWORD=<password>

# JWT secret must be at least 32 bytes (HS256)
JWT_SECRET=

# Optional: seed an admin user (only runs if both are set)
ADMIN_USERNAME=
ADMIN_PASSWORD=

